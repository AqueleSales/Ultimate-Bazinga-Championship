# Application
# Generate a unique secret (never commit your real .env file).
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=1
# Set to 1 only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0

# Shared invite code: configure a long random value to keep new OAuth access limited to friends.
# Anyone who needs access must enter this code before signing in.
UBC_INVITE_CODE=

# Database (Neon PostgreSQL); leave empty to use local SQLite.
DATABASE_URL=

# Google OAuth 2.0 / OpenID Connect
# Authorized redirect URI for local development:
# http://127.0.0.1:5000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth 2.0
# Redirect URI for local development:
# http://127.0.0.1:5000/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Supabase Storage (private bucket). Never commit real credentials.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ubc-media
SUPABASE_STORAGE_SIGNED_URL_TTL=3600
